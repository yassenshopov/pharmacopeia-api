# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Generated Prisma client (regenerated by `prisma generate`)
/lib/generated

# Scale-ingest artifacts (5,000+ drug dataset; lives in Supabase, not the
# bundle). Regenerated by `npm run ingest:universe` + `npm run ingest:scale`.
/data/ingest

# SDK package build artifacts (regenerated by `npm --prefix sdk/<x> run build`)
/sdk/mcp/dist
/sdk/typescript/dist

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
