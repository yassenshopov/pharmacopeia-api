{
  "name": "@pharmacopeia/client",
  "version": "0.1.0",
  "description": "Thin, fully-typed TypeScript client for the pharmacopeia API. Types are generated from the same Zod schemas the API uses.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pharmacopeia",
    "drugs",
    "api",
    "client",
    "sdk"
  ],
  "sideEffects": false,
  "devDependencies": {
    "typescript": "^5.6.0"
  }
}
