{
  "name": "pharmacopeia-mcp",
  "version": "0.1.0",
  "description": "Model Context Protocol server for the pharmacopeia API. Lets Claude, Cursor, Codex, and other MCP-aware agents pull drug, class, ingredient, interaction, and structure facts straight into their context window.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "pharmacopeia-mcp": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "pharmacopeia",
    "drugs",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "ai",
    "agents"
  ],
  "sideEffects": false,
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@pharmacopeia/client": "file:../typescript",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.6.0"
  }
}
