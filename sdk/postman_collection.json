{
  "info": {
    "name": "pharmacopeia API",
    "description": "Developer-first reference API for medications. Educational / informational use only. Set the `baseUrl` collection variable to your host (default is production) and `apiKey` for the key-gated operations.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://pharmacopeia.dev/api/v1"
    },
    {
      "key": "apiKey",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Drugs",
      "description": "Browse, fetch, and explore drugs. Includes per-drug interactions and structural neighbours.",
      "item": [
        {
          "name": "List drugs (paginated), optionally filtered by class or ingredient.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drugs",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drugs"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "",
                  "description": "Page size (1–200, default 50).",
                  "disabled": true
                },
                {
                  "key": "offset",
                  "value": "",
                  "description": "Zero-based offset.",
                  "disabled": true
                },
                {
                  "key": "class",
                  "value": "",
                  "description": "Filter to drugs in this class slug.",
                  "disabled": true
                },
                {
                  "key": "ingredient",
                  "value": "",
                  "description": "Filter to drugs containing this ingredient slug.",
                  "disabled": true
                },
                {
                  "key": "q",
                  "value": "",
                  "description": "Case-insensitive substring filter over name, slug, synonyms, brands, and ingredient names.",
                  "disabled": true
                },
                {
                  "key": "jurisdiction",
                  "value": "",
                  "description": "Filter by regulatory jurisdiction (US-FDA, EU-EMA, UK-MHRA, CA-HC). The v0 dataset is US-FDA only.",
                  "disabled": true
                }
              ]
            },
            "description": "`GET /drugs`"
          }
        },
        {
          "name": "Fetch a single drug by slug.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drug/{slug}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drug",
                ":slug"
              ],
              "variable": [
                {
                  "key": "slug",
                  "value": ""
                }
              ],
              "query": [
                {
                  "key": "fields",
                  "value": "",
                  "description": "Optional comma-separated list of sections to include (mechanism, indications, contraindications, dosing, pharmacokinetics, interactions, labelSections, approvalHistory, chemical, patientSummary). Identity fields are always returned. Omit for the full record.",
                  "disabled": true
                },
                {
                  "key": "asOf",
                  "value": "",
                  "description": "Dataset time-travel: ISO-8601 instant. Records are a single newest snapshot, so this gates by extraction time — a drug extracted after this instant 404s (it was not yet in the dataset). See /drug/{slug}/history for the full change timeline.",
                  "disabled": true
                }
              ]
            },
            "description": "`GET /drug/{slug}`"
          }
        },
        {
          "name": "Fetch up to 100 drug records in a single round-trip. Returns the full records found plus the slugs that did not resolve.",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/drugs/batch",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drugs",
                "batch"
              ]
            },
            "description": "`POST /drugs/batch`",
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "List known interactions for a drug.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drug/{slug}/interactions",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drug",
                ":slug",
                "interactions"
              ],
              "variable": [
                {
                  "key": "slug",
                  "value": ""
                }
              ]
            },
            "description": "`GET /drug/{slug}/interactions`"
          }
        },
        {
          "name": "Dataset time-travel: the drug's current-snapshot provenance plus its change-event timeline (newest first). Pin ?asOf= to trim the timeline to a past instant. Leans on provenance + the changelog; no separate version store.",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drug/{slug}/history",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drug",
                ":slug",
                "history"
              ],
              "variable": [
                {
                  "key": "slug",
                  "value": ""
                }
              ],
              "query": [
                {
                  "key": "asOf",
                  "value": "",
                  "description": "ISO-8601 instant; only change events at or before it are returned, and the instant is echoed back in `asOf`.",
                  "disabled": true
                }
              ]
            },
            "description": "`GET /drug/{slug}/history`"
          }
        },
        {
          "name": "Structurally similar drugs (Tanimoto over 2D fingerprints).",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/drug/{slug}/similar",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "drug",
                ":slug",
                "similar"
              ],
              "variable": [
                {
                  "key": "slug",
                  "value": ""
                }
              ]
            },
            "description": "`GET /drug/{slug}/similar`"
          }
        }
      ]
    },
